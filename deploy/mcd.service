[Unit]
Description=Minecraft Plugin Dev Server (pluginDev)
After=network.target remote-fs.target

# Stop retrying after 3 failures in 10 min. An unlimited restart loop once
# filled the disk and corrupted the world -- keep these.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
# Whole process (heap + JVM overhead) capped at 4G; the 3G heap leaves room for the overhead.
MemoryMax=4G
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft/pluginDev
# Files the server creates stay group-writable, so members of the minecraft
# group can drop in new plugin builds without sudo.
UMask=0002

# --- JVM flags (Java 25 / Paper, Aikar's flags). Modeled on mcs.service.
# Process tag, so ps/top can tell the servers apart
Environment="JVM_ID=-DXX=PluginDev"
# Smaller fixed heap than survival (8G): it's a test server.
Environment="JVM_HEAP=-Xms3G -Xmx3G -XX:+AlwaysPreTouch -XX:+UseTransparentHugePages"
# JDK 25 compact object headers (JEP 519)
Environment="JVM_JDK25=-XX:+UseCompactObjectHeaders"
# G1 collector, 200ms pause target. GC threads capped at 2: three JVMs now share 8 hardware threads.
Environment="JVM_GC=-XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ParallelRefProcEnabled -XX:+DisableExplicitGC -XX:ParallelGCThreads=2"
# G1 tuning (Aikar). Region size left to the JVM.
Environment="JVM_G1=-XX:+UnlockExperimentalVMOptions -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:SurvivorRatio=32 -XX:MaxTenuringThreshold=1 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCCountTarget=4 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1HeapWastePercent=5 -XX:G1ReservePercent=20 -XX:G1RSetUpdatingPauseTimePercent=5"
# No hsperfdata (jstat/jps won't see it; use spark), plus Paper's flag markers
Environment="JVM_MISC=-XX:+PerfDisableSharedMem -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true"

ExecStart=/usr/bin/java $JVM_ID $JVM_HEAP $JVM_JDK25 $JVM_GC $JVM_G1 $JVM_MISC -jar /opt/minecraft/jars/latest.jar --nogui

# --- Shutdown
# RCON "stop", then wait for exit. Credentials live in the root-only env file.
EnvironmentFile=/etc/minecraft/mcd.env
ExecStop=/usr/local/bin/mc-stop $MAINPID
# If RCON fails, SIGTERM (Paper saves cleanly on it too; exits 143).
KillSignal=SIGTERM
TimeoutStopSec=300
SuccessExitStatus=143

Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
